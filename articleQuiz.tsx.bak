'use client'
import { useEffect, useMemo, useState } from 'react'
import { supabase } from '@/lib/supabase/client'
import { speak } from '@/lib/speak'
import { LEVELS, topicLabel, type Word } from '@/lib/types'

type Art = 'der' | 'die' | 'das'
type Res = { w: Word; ok: boolean; picked: Art }
const ARTS: Art[] = ['der', 'die', 'das']
const BG: Record<Art, string> = { der: 'bg-blue-600', die: 'bg-red-600', das: 'bg-green-600' }
const TXT: Record<Art, string> = { der: 'text-blue-600', die: 'text-red-600', das: 'text-green-600' }

const RULES: [RegExp, Art, string][] = [
  [/(ung|heit|keit|schaft|tion|ität|ik|ur)$/i, 'die', 'Terminaciones -ung, -heit, -keit, -schaft, -tion, -ität → casi siempre «die».'],
  [/in$/i, 'die', 'Forma femenina de personas en -in → «die».'],
  [/(chen|lein|ment|um)$/i, 'das', 'Diminutivos -chen / -lein y terminaciones -ment, -um → «das».'],
  [/(ling|ismus)$/i, 'der', 'Terminaciones -ling, -ismus → «der».'],
  [/er$/i, 'der', 'Muchas personas y oficios masculinos en -er → «der».'],
  [/e$/i, 'die', 'La mayoría de las palabras en -e son «die».'],
]
function hint(w: Word): string | null {
  if (/plural/i.test(w.es)) return 'Todos los plurales llevan «die».'
  if (w.topic === 'dias') return 'Los días de la semana son siempre «der».'
  const r = RULES.find(([re, a]) => a === w.article && re.test(w.de))
  return r ? r[2] : null
}

export default function ArticleQuiz() {
  const sb = useMemo(() => supabase(), [])
  const [words, setWords] = useState<Word[]>([])
  const [mine, setMine] = useState<Set<string>>(new Set())
  const [loading, setLoading] = useState(true)
  const [level, setLevel] = useState('')
  const [topic, setTopic] = useState('')
  const [scope, setScope] = useState<'all' | 'mine'>('all')
  const [count, setCount] = useState(10)
  const [phase, setPhase] = useState<'setup' | 'play' | 'done'>('setup')
  const [queue, setQueue] = useState<Word[]>([])
  const [idx, setIdx] = useState(0)
  const [picked, setPicked] = useState<Art | null>(null)
  const [res, setRes] = useState<Res[]>([])

  useEffect(() => {
    ;(async () => {
      const [w, c] = await Promise.all([
        sb.from('words').select('*').not('article', 'is', null),
        sb.from('user_cards').select('word_id').eq('track', 'meaning'),
      ])
      setWords((w.data ?? []) as Word[])
      setMine(new Set((c.data ?? []).map((r: { word_id: string }) => r.word_id)))
      setLoading(false)
    })()
  }, [sb])

  const topics = [...new Set(words.map((w) => w.topic))]
  const pool = words.filter((w) => (!level || w.level === level) && (!topic || w.topic === topic) && (scope === 'all' || mine.has(w.id)))
  const cur = queue[idx]

  async function start(list?: Word[]) {
    let q = list
    if (!q) {
      // Prioriza las palabras que más has fallado
      const { data: log } = await sb.from('review_log').select('word_id, rating').eq('track', 'article')
        .order('reviewed_at', { ascending: false }).limit(500)
      const fails = new Map<string, number>()
      ;(log ?? []).forEach((r: { word_id: string; rating: number }) => {
        if (r.rating === 0) fails.set(r.word_id, (fails.get(r.word_id) ?? 0) + 1)
      })
      q = pool.map((w) => ({ w, s: (fails.get(w.id) ?? 0) * 2 + Math.random() * 3 }))
        .sort((a, b) => b.s - a.s).slice(0, count).map((x) => x.w)
    }
    setQueue([...q].sort(() => Math.random() - 0.5))
    setIdx(0); setPicked(null); setRes([]); setPhase('play')
  }

  async function answer(a: Art) {
    if (picked || !cur || !cur.article) return
    const ok = a === cur.article
    setPicked(a)
    setRes((r) => [...r, { w: cur, ok, picked: a }])
    speak(`${cur.article} ${cur.de}`)
    await sb.from('review_log').insert({ word_id: cur.id, track: 'article', rating: ok ? 2 : 0 })
  }

  function nextQ() {
    if (idx + 1 >= queue.length) setPhase('done')
    else { setIdx(idx + 1); setPicked(null) }
  }

  useEffect(() => {
    if (phase !== 'play') return
    const h = (e: KeyboardEvent) => {
      if (!picked && e.key.length === 1 && '123'.includes(e.key)) answer(ARTS[Number(e.key) - 1])
      else if (picked && (e.key === 'Enter' || e.code === 'Space')) { e.preventDefault(); nextQ() }
    }
    window.addEventListener('keydown', h)
    return () => window.removeEventListener('keydown', h)
  }) // eslint-disable-line

  const inp = 'w-full rounded-lg border border-stone-300 bg-white p-2 text-sm dark:border-neutral-700 dark:bg-neutral-900'
  const box = 'rounded-2xl border border-stone-200 bg-white p-6 dark:border-neutral-800 dark:bg-neutral-900'
  const score = res.filter((r) => r.ok).length

  if (loading) return <p className="opacity-60">Cargando…</p>

  if (phase === 'setup') return (
    <div className="space-y-4">
      <h1 className="text-xl font-bold">der · die · das</h1>
      <p className="text-sm opacity-70">Te muestro un sustantivo y eliges su artículo. Las palabras que más fallas salen con más frecuencia.</p>
      <div className={box + ' space-y-3'}>
        <div className="grid grid-cols-2 gap-2">
          <select className={inp} value={level} onChange={(e) => setLevel(e.target.value)}>
            <option value="">Todos los niveles</option>{LEVELS.map((l) => <option key={l}>{l}</option>)}
          </select>
          <select className={inp} value={topic} onChange={(e) => setTopic(e.target.value)}>
            <option value="">Todos los temas</option>{topics.map((t) => <option key={t} value={t}>{topicLabel(t)}</option>)}
          </select>
          <select className={inp} value={scope} onChange={(e) => setScope(e.target.value as 'all' | 'mine')}>
            <option value="all">Todo el catálogo</option><option value="mine">Solo mis palabras</option>
          </select>
          <select className={inp} value={count} onChange={(e) => setCount(Number(e.target.value))}>
            {[5, 10, 20, 30].map((n) => <option key={n} value={n}>{n} preguntas</option>)}
          </select>
        </div>
        <p className="text-sm opacity-70">{pool.length} sustantivos disponibles</p>
        <button disabled={!pool.length} onClick={() => start()} className="w-full rounded-lg bg-red-600 p-3 font-medium text-white disabled:opacity-40">Empezar</button>
      </div>
    </div>
  )

  if (phase === 'done') {
    const missed = res.filter((r) => !r.ok)
    return (
      <div className="space-y-4">
        <div className={box + ' text-center'}>
          <div className="text-4xl font-bold">{score}/{res.length}</div>
          <div className="mt-1 opacity-70">{score === res.length ? '¡Perfecto! 🎉' : score / res.length >= 0.7 ? '¡Muy bien!' : 'Sigue practicando 💪'}</div>
        </div>
        {missed.length > 0 && (
          <div className={box}>
            <b>Para repasar</b>
            {missed.map((r) => (
              <div key={r.w.id} className="flex items-center gap-2 border-b border-stone-200 py-2 last:border-0 dark:border-neutral-800">
                <span className="flex-1"><b className={TXT[r.w.article!]}>{r.w.article}</b> <b>{r.w.de}</b> <span className="text-sm opacity-60">· {r.w.es}</span></span>
                <span className="text-sm line-through opacity-50">{r.picked}</span>
                <button onClick={() => speak(`${r.w.article} ${r.w.de}`)}>🔊</button>
              </div>
            ))}
          </div>
        )}
        <div className="flex gap-2">
          {missed.length > 0 && <button onClick={() => start(missed.map((r) => r.w))} className="flex-1 rounded-lg bg-red-600 p-3 font-medium text-white">Repetir falladas</button>}
          <button onClick={() => start()} className="flex-1 rounded-lg border border-stone-300 p-3 dark:border-neutral-700">Nueva ronda</button>
          <button onClick={() => setPhase('setup')} className="rounded-lg border border-stone-300 px-4 dark:border-neutral-700">⚙️</button>
        </div>
      </div>
    )
  }

  const h = picked && cur ? hint(cur) : null
  return (
    <div className="space-y-4">
      <div className="flex justify-between text-sm opacity-70"><span>Pregunta {idx + 1}/{queue.length}</span><span>✓ {score}</span></div>
      <div className={box + ' text-center'}>
        <div className="text-sm opacity-60">¿Qué artículo lleva…?</div>
        <div className="mt-2 text-4xl font-bold">{cur.de}</div>
        <div className="mt-1 opacity-70">{cur.es}</div>
        {picked && (
          <div className="mt-5 space-y-1 border-t border-dashed border-stone-300 pt-4 dark:border-neutral-700">
            <div className="text-lg">{picked === cur.article ? '✅ ¡Correcto!' : '❌ Es '}
              {picked !== cur.article && <b className={TXT[cur.article!]}>{cur.article}</b>}</div>
            <div className="text-xl font-bold"><span className={TXT[cur.article!]}>{cur.article}</span> {cur.de}</div>
            {cur.example && <div className="italic opacity-70">{cur.example}</div>}
            {h && <div className="pt-1 text-sm opacity-80">💡 {h}</div>}
          </div>
        )}
      </div>
      <div className="grid grid-cols-3 gap-2">
        {ARTS.map((a, i) => {
          const state = !picked ? '' : a === cur.article ? 'ring-4 ring-green-400' : a === picked ? 'opacity-40 line-through' : 'opacity-40'
          return (
            <button key={a} disabled={!!picked} onClick={() => answer(a)} className={`rounded-xl p-4 text-xl font-bold text-white ${BG[a]} ${state}`}>
              {a}<small className="block text-xs font-normal opacity-70">{i + 1}</small>
            </button>
          )
        })}
      </div>
      {picked && <button onClick={nextQ} className="w-full rounded-lg border border-stone-300 p-3 dark:border-neutral-700">{idx + 1 >= queue.length ? 'Ver resultado' : 'Siguiente →'}</button>}
    </div>
  )
}'use client'
import { useEffect, useMemo, useState } from 'react'
import { supabase } from '@/lib/supabase/client'
import { speak } from '@/lib/speak'
import { LEVELS, topicLabel, type Word } from '@/lib/types'

type Art = 'der' | 'die' | 'das'
type Res = { w: Word; ok: boolean; picked: Art }
const ARTS: Art[] = ['der', 'die', 'das']
const BG: Record<Art, string> = { der: 'bg-blue-600', die: 'bg-red-600', das: 'bg-green-600' }
